{
  "info": {"name": "Fuel Route Optimizer", "description": "Django fuel-route assessment API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000"}],
  "item": [
    {"name": "Short route", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Austin, TX\"\n}"}, "url": {"raw": "{{base_url}}/api/v1/route/", "host": ["{{base_url}}"], "path": ["api", "v1", "route", ""]}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('Route and summary exist', () => { pm.expect(json.route).to.exist; pm.expect(json.summary.total_fuel_cost).to.exist; });"]}}]},
    {"name": "Long route — multiple stops", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Miami, FL\"\n}"}, "url": {"raw": "{{base_url}}/api/v1/route/", "host": ["{{base_url}}"], "path": ["api", "v1", "route", ""]}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('Fuel plan returned', () => { pm.expect(json.route).to.exist; pm.expect(json.summary).to.exist; pm.expect(json.summary.total_fuel_cost).to.exist; });"]}}]},
    {"name": "Invalid request", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"start\": \"Dallas, TX\"\n}"}, "url": {"raw": "{{base_url}}/api/v1/route/", "host": ["{{base_url}}"], "path": ["api", "v1", "route", ""]}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Validation error', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));"]}}]}
  ]
}
